{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "am-digital-lab",
  "main": "worker-public.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRM_DB",
        "class_name": "CRMDatabase",
        "script_name": "am-digital-lab-crm"
      }
    ]
  }
}
