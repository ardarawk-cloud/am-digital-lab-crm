{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "am-digital-lab",
  "main": "worker-public.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "vars": {
    "CRM_LEAD_ENDPOINT": "https://am-digital-lab-crm.ardarawk.workers.dev/api/public/leads"
  }
}
