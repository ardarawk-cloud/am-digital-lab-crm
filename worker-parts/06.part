  if(method==='POST'&&path==='/api/change-requests'){const d=await readBody(request);if(!d.project_id||!d.description)return reply({error:'Project dan deskripsi perubahan wajib diisi.'},400);const code=await nextCode(DB,'change_requests','AMD-CR');const r=await DB.prepare('INSERT INTO change_requests (code,project_id,requested_by,description,reason,cost_impact,timeline_impact_days,status) VALUES (?,?,?,?,?,?,?,?)').bind(code,Number(d.project_id),d.requested_by||'Client',d.description,d.reason||'',Number(d.cost_impact||0),Number(d.timeline_impact_days||0),d.status||'REQUESTED').run();const id=Number(r.meta?.last_row_id||0);await log(DB,user,`Created change request ${code}`,'change_request',id);return reply({ok:true,id,code},201);}
  m=match(path,'/api/change-requests/:id');if(method==='PATCH'&&m){const d=await readBody(request);await updateFields(DB,'change_requests',m.id,d,['requested_by','description','reason','cost_impact','timeline_impact_days','status'],['cost_impact','timeline_impact_days']);await log(DB,user,`Updated change request #${m.id}`,'change_request',Number(m.id));return reply({ok:true});}
  m=match(path,'/api/change-requests/:id/invoice');if(method==='POST'&&m){const cr=await DB.prepare(`SELECT cr.*,p.client_id FROM change_requests cr JOIN projects p ON p.id=cr.project_id WHERE cr.id=?`).bind(Number(m.id)).first();if(!cr)return reply({error:'Change Request tidak ditemukan.'},404);if(cr.invoice_id)return reply({error:'Invoice CR sudah dibuat.'},409);if(cr.status!=='APPROVED')return reply({error:'Change Request harus APPROVED sebelum invoice dibuat.'},409);if(Number(cr.cost_impact)<=0)return reply({error:'Cost impact harus lebih dari 0.'},409);const code=await nextCode(DB,'invoices','AMD-INV');await DB.batch([DB.prepare('INSERT INTO invoices (code,client_id,project_id,type,amount,issue_date,status,notes) VALUES (?,?,?,?,?,?,?,?)').bind(code,cr.client_id,cr.project_id,'CHANGE REQUEST',Number(cr.cost_impact),today(),'SENT',`Auto-created from ${cr.code}`),DB.prepare('UPDATE change_requests SET invoice_id=(SELECT id FROM invoices WHERE code=?) WHERE id=?').bind(code,cr.id),DB.prepare('UPDATE projects SET value=value+? WHERE id=?').bind(Number(cr.cost_impact),cr.project_id)]);const inv=await DB.prepare('SELECT id FROM invoices WHERE code=?').bind(code).first();await log(DB,user,`Created ${code} from ${cr.code}`,'invoice',inv?.id||null);return reply({ok:true,invoice_id:inv?.id,code},201);}

  if(method==='GET'&&path==='/api/qc'){const pid=url.searchParams.get('project_id');const sql=pid?`SELECT q.*,p.code project_code,p.name project_name FROM qc_items q JOIN projects p ON p.id=q.project_id WHERE q.project_id=? ORDER BY q.id DESC`:`SELECT q.*,p.code project_code,p.name project_name FROM qc_items q JOIN projects p ON p.id=q.project_id ORDER BY q.id DESC`;return reply({items:await rows(pid?DB.prepare(sql).bind(Number(pid)):DB.prepare(sql))});}
  if(method==='POST'&&path==='/api/qc'){const d=await readBody(request);if(!d.project_id||!d.title)return reply({error:'Project dan QC item wajib diisi.'},400);const code=await nextCode(DB,'qc_items','AMD-QC');const r=await DB.prepare('INSERT INTO qc_items (code,project_id,module,title,description,severity,status,assigned_to,evidence) VALUES (?,?,?,?,?,?,?,?,?)').bind(code,Number(d.project_id),d.module||'Core',d.title,d.description||'',d.severity||'MEDIUM',d.status||'NOT TESTED',d.assigned_to||'',d.evidence||'').run();const id=Number(r.meta?.last_row_id||0);await log(DB,user,`Created QC ${code}`,'qc',id);return reply({ok:true,id,code},201);}
  m=match(path,'/api/qc/:id');if(method==='PATCH'&&m){const d=await readBody(request);await updateFields(DB,'qc_items',m.id,d,['module','title','description','severity','status','assigned_to','evidence']);await log(DB,user,`Updated QC #${m.id}`,'qc',Number(m.id));return reply({ok:true});}

  return reply({error:'API route not found'},404);
}

export default {
  async fetch(request,env){
    try{
      const url=new URL(request.url);
      const DB=durableDB(env.CRM_DB);
      const runtimeEnv={...env,DB};
      if(url.pathname==='/healthz'){
        await ensureSchema(DB);
        const database=await DB.health();
        return reply({ok:database,service:'am-digital-lab-crm',version:VERSION,storage:'sqlite-durable-object',database});
      }
      if(url.pathname.startsWith('/api/')){await ensureSchema(DB);return await api(request,runtimeEnv,url);}
      return env.ASSETS.fetch(request);
    }catch(err){console.error(err);return reply({error:'Internal server error',code:'AMDL_WORKER_ERROR'},500);}
  }
};
