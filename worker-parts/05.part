  if(method==='POST'&&path==='/api/quotations'){const d=await readBody(request),items=Array.isArray(d.items)?d.items.filter(x=>x&&x.description):[];if(!d.client_id)return reply({error:'Client wajib dipilih.'},400);if(!items.length)return reply({error:'Quotation harus memiliki minimal satu item.'},400);const code=await nextCode(DB,'quotations','AMD-Q'),subtotal=items.reduce((a,x)=>a+Number(x.qty||1)*Number(x.unit_price||0),0);const stmts=[DB.prepare('INSERT INTO quotations (code,client_id,project_id,issue_date,expiry_date,status,subtotal,notes) VALUES (?,?,?,?,?,?,?,?)').bind(code,Number(d.client_id),d.project_id?Number(d.project_id):null,d.issue_date||today(),d.expiry_date||'',d.status||'DRAFT',subtotal,d.notes||'')];for(const x of items){const q=Number(x.qty||1),u=Number(x.unit_price||0);stmts.push(DB.prepare('INSERT INTO quotation_items (quotation_id,description,qty,unit_price,amount) SELECT id,?,?,?,? FROM quotations WHERE code=?').bind(x.description,q,u,q*u,code));}await DB.batch(stmts);const q=await DB.prepare('SELECT id FROM quotations WHERE code=?').bind(code).first();await log(DB,user,`Created quotation ${code}`,'quotation',q?.id||null);return reply({ok:true,id:q?.id,code,subtotal},201);}
  m=match(path,'/api/quotations/:id');
  if(method==='GET'&&m){const q=await DB.prepare(`SELECT q.*,c.name client_name,c.company,p.name project_name FROM quotations q JOIN clients c ON c.id=q.client_id LEFT JOIN projects p ON p.id=q.project_id WHERE q.id=?`).bind(Number(m.id)).first();if(!q)return reply({error:'Quotation tidak ditemukan.'},404);q.items=await rows(DB.prepare('SELECT * FROM quotation_items WHERE quotation_id=? ORDER BY id').bind(Number(m.id)));return reply(q);}
  if(method==='PATCH'&&m){const d=await readBody(request),allowed=['DRAFT','SENT','VIEWED','NEGOTIATION','APPROVED','REJECTED','EXPIRED'];if(d.status&&!allowed.includes(d.status))return reply({error:'Status quotation tidak valid.'},400);await updateFields(DB,'quotations',m.id,d,['status','expiry_date','notes']);await log(DB,user,`Updated quotation #${m.id}`,'quotation',Number(m.id));return reply({ok:true});}

  if(method==='GET'&&path==='/api/invoices')return reply({items:await rows(DB.prepare(`SELECT i.*,c.name client_name,p.name project_name FROM invoices i JOIN clients c ON c.id=i.client_id LEFT JOIN projects p ON p.id=i.project_id ORDER BY i.id DESC`))});
  if(method==='POST'&&path==='/api/invoices'){const d=await readBody(request);if(!d.client_id||Number(d.amount||0)<=0)return reply({error:'Client dan nominal invoice wajib diisi.'},400);const code=await nextCode(DB,'invoices','AMD-INV');const r=await DB.prepare('INSERT INTO invoices (code,client_id,project_id,type,amount,issue_date,due_date,status,notes) VALUES (?,?,?,?,?,?,?,?,?)').bind(code,Number(d.client_id),d.project_id?Number(d.project_id):null,d.type||'DP',Number(d.amount),d.issue_date||today(),d.due_date||'',d.status||'SENT',d.notes||'').run();const id=Number(r.meta?.last_row_id||0);await log(DB,user,`Created invoice ${code}`,'invoice',id);return reply({ok:true,id,code},201);}
  m=match(path,'/api/invoices/:id/payments');
  if(method==='POST'&&m){const d=await readBody(request),id=Number(m.id),inv=await DB.prepare('SELECT * FROM invoices WHERE id=?').bind(id).first();if(!inv)return reply({error:'Invoice tidak ditemukan.'},404);const amount=Math.max(0,Number(d.amount||0));if(!amount)return reply({error:'Nominal pembayaran harus lebih dari 0.'},400);const outstanding=Math.max(0,Number(inv.amount)-Number(inv.paid_amount));if(amount>outstanding)return reply({error:`Pembayaran melebihi outstanding (${outstanding}).`},409);await DB.prepare('INSERT INTO payments (invoice_id,amount,payment_date,method,reference,notes) VALUES (?,?,?,?,?,?)').bind(id,amount,d.payment_date||today(),d.method||'Bank Transfer',d.reference||'',d.notes||'').run();const paid=await scalar(DB.prepare('SELECT COALESCE(SUM(amount),0) v FROM payments WHERE invoice_id=?').bind(id),'v'),status=paid>=Number(inv.amount)?'PAID':paid>0?'PARTIAL':inv.status;await DB.prepare('UPDATE invoices SET paid_amount=?,status=? WHERE id=?').bind(paid,status,id).run();await log(DB,user,`Recorded payment for ${inv.code}`,'invoice',id);return reply({ok:true,paid_amount:paid,status},201);}

  if(method==='GET'&&path==='/api/tasks'){const pid=url.searchParams.get('project_id');const sql=pid?`SELECT t.*,p.code project_code,p.name project_name FROM tasks t JOIN projects p ON p.id=t.project_id WHERE t.project_id=? ORDER BY t.id DESC`:`SELECT t.*,p.code project_code,p.name project_name FROM tasks t JOIN projects p ON p.id=t.project_id ORDER BY t.id DESC`;return reply({items:await rows(pid?DB.prepare(sql).bind(Number(pid)):DB.prepare(sql))});}
  if(method==='POST'&&path==='/api/tasks'){const d=await readBody(request);if(!d.project_id||!d.title)return reply({error:'Project dan task wajib diisi.'},400);const r=await DB.prepare('INSERT INTO tasks (project_id,module,title,description,assigned_to,priority,status,due_date) VALUES (?,?,?,?,?,?,?,?)').bind(Number(d.project_id),d.module||'Core',d.title,d.description||'',d.assigned_to||'',d.priority||'NORMAL',d.status||'TODO',d.due_date||'').run();const id=Number(r.meta?.last_row_id||0);await log(DB,user,`Created task #${id}`,'task',id);return reply({ok:true,id},201);}
  m=match(path,'/api/tasks/:id');if(method==='PATCH'&&m){const d=await readBody(request);await updateFields(DB,'tasks',m.id,d,['module','title','description','assigned_to','priority','status','due_date']);await log(DB,user,`Updated task #${m.id}`,'task',Number(m.id));return reply({ok:true});}

  if(method==='GET'&&path==='/api/change-requests')return reply({items:await rows(DB.prepare(`SELECT cr.*,p.code project_code,p.name project_name,c.name client_name,i.code invoice_code FROM change_requests cr JOIN projects p ON p.id=cr.project_id JOIN clients c ON c.id=p.client_id LEFT JOIN invoices i ON i.id=cr.invoice_id ORDER BY cr.id DESC`))});
