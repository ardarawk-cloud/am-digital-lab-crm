  if(method==='POST'&&path==='/api/clients'){const d=await readBody(request);if(!d.name)return reply({error:'Nama client wajib diisi.'},400);const code=await nextCode(DB,'clients','AMD-C');const r=await DB.prepare('INSERT INTO clients (code,name,company,phone,email,notes) VALUES (?,?,?,?,?,?)').bind(code,d.name,d.company||'',d.phone||'',d.email||'',d.notes||'').run();const id=Number(r.meta?.last_row_id||0);await log(DB,user,`Created client ${code}`,'client',id);return reply({ok:true,id,code},201);}

  if(method==='GET'&&path==='/api/projects')return reply({items:await rows(DB.prepare(`SELECT p.*,c.name client_name,c.company client_company,COALESCE((SELECT SUM(pay.amount) FROM payments pay JOIN invoices i ON i.id=pay.invoice_id WHERE i.project_id=p.id),0) paid,(SELECT COUNT(*) FROM tasks t WHERE t.project_id=p.id AND t.status!='DONE') open_tasks,(SELECT COUNT(*) FROM project_scope s WHERE s.project_id=p.id) scope_items,(SELECT COUNT(*) FROM qc_items q WHERE q.project_id=p.id AND q.severity='CRITICAL' AND q.status NOT IN ('PASS','LOCKED')) critical_qc FROM projects p JOIN clients c ON c.id=p.client_id ORDER BY p.id DESC`))});
  if(method==='POST'&&path==='/api/projects'){const d=await readBody(request);if(!d.client_id||!d.name)return reply({error:'Client dan nama project wajib diisi.'},400);const code=await nextCode(DB,'projects','AMD');const r=await DB.prepare('INSERT INTO projects (code,client_id,name,project_type,value,status,health,progress,deadline,pm,scope_summary,scope_approved) VALUES (?,?,?,?,?,?,?,?,?,?,?,0)').bind(code,Number(d.client_id),d.name,d.project_type||'Website',Number(d.value||0),'QUEUED',d.health||'GREEN',Number(d.progress||0),d.deadline||'',d.pm||'',d.scope_summary||'').run();const id=Number(r.meta?.last_row_id||0);await log(DB,user,`Created project ${code}`,'project',id);return reply({ok:true,id,code},201);}
  m=match(path,'/api/projects/:id');
  if(method==='PATCH'&&m){const d=await readBody(request),id=Number(m.id),p=await DB.prepare('SELECT * FROM projects WHERE id=?').bind(id).first();if(!p)return reply({error:'Project tidak ditemukan.'},404);if(d.status&&d.status!=='QUEUED'&&!await activeProjectAllowed(DB,id))return reply({error:'Project belum bisa diaktifkan: pembayaran DP belum tercatat.'},409);if(d.status&&guardedProjectStatuses.includes(d.status)&&!await scopeReady(DB,id))return reply({error:'Development belum bisa lanjut: scope belum memiliki item dan belum di-approve.'},409);if(d.status&&['DEPLOYMENT','DELIVERED'].includes(d.status)&&await hasBlockingQc(DB,id))return reply({error:'Production blocked: masih ada CRITICAL QC yang belum PASS/LOCKED.'},409);await updateFields(DB,'projects',id,d,['name','project_type','value','status','health','progress','deadline','pm','scope_summary'],['value','progress']);await log(DB,user,`Updated project #${id}`,'project',id);return reply({ok:true});}
  m=match(path,'/api/projects/:id/scope-approval');
  if(method==='PATCH'&&m){const id=Number(m.id),d=await readBody(request),n=await scalar(DB.prepare('SELECT COUNT(*) c FROM project_scope WHERE project_id=? AND included_contract=1').bind(id));if(d.approved&&!n)return reply({error:'Tambahkan minimal satu scope item sebelum approval.'},409);await DB.prepare('UPDATE projects SET scope_approved=? WHERE id=?').bind(d.approved?1:0,id).run();await log(DB,user,`${d.approved?'Approved':'Unlocked'} project scope #${id}`,'project',id);return reply({ok:true,scope_approved:d.approved?1:0});}
  m=match(path,'/api/projects/:id/scope');
  if(method==='GET'&&m){const project=await DB.prepare('SELECT * FROM projects WHERE id=?').bind(Number(m.id)).first();if(!project)return reply({error:'Project tidak ditemukan.'},404);return reply({project,items:await rows(DB.prepare('SELECT * FROM project_scope WHERE project_id=? ORDER BY id').bind(Number(m.id)))});}
  if(method==='POST'&&m){const id=Number(m.id),d=await readBody(request),p=await DB.prepare('SELECT * FROM projects WHERE id=?').bind(id).first();if(!p)return reply({error:'Project tidak ditemukan.'},404);if(Number(p.scope_approved)===1)return reply({error:'Scope sudah approved. Unlock scope sebelum menambah item.'},409);if(!d.title)return reply({error:'Nama scope wajib diisi.'},400);const r=await DB.prepare('INSERT INTO project_scope (project_id,module,title,description,priority,status,included_contract) VALUES (?,?,?,?,?,?,?)').bind(id,d.module||'Core',d.title,d.description||'',d.priority||'MUST HAVE',d.status||'PLANNED',d.included_contract===false?0:1).run();const itemId=Number(r.meta?.last_row_id||0);await log(DB,user,`Added scope item to ${p.code}`,'scope',itemId);return reply({ok:true,id:itemId},201);}
  m=match(path,'/api/scope/:id');
  if(method==='PATCH'&&m){const id=Number(m.id),d=await readBody(request),s=await DB.prepare('SELECT s.*,p.scope_approved FROM project_scope s JOIN projects p ON p.id=s.project_id WHERE s.id=?').bind(id).first();if(!s)return reply({error:'Scope item tidak ditemukan.'},404);if(Number(s.scope_approved)===1&&Object.keys(d).some(k=>['title','description','module','priority','included_contract'].includes(k)))return reply({error:'Scope sudah approved. Unlock dulu untuk mengubah requirement.'},409);await updateFields(DB,'project_scope',id,d,['module','title','description','priority','status','included_contract'],[],['included_contract']);await log(DB,user,`Updated scope item #${id}`,'scope',id);return reply({ok:true});}

  if(method==='GET'&&path==='/api/quotations')return reply({items:await rows(DB.prepare(`SELECT q.*,c.name client_name,p.name project_name,(SELECT COUNT(*) FROM quotation_items qi WHERE qi.quotation_id=q.id) item_count FROM quotations q JOIN clients c ON c.id=q.client_id LEFT JOIN projects p ON p.id=q.project_id ORDER BY q.id DESC`))});
