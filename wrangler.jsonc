{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "am-digital-lab-crm",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CRM_DB",
        "class_name": "CRMDatabase"
      }
    ]
  },
  "exports": {
    "CRMDatabase": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "AMDL_ADMIN_EMAIL": "admin@amdigital.local"
  }
}
